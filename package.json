{
  "name": "google-reviews-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:backend": "pnpm --filter google-reviews-backend dev",
    "dev:mobile": "pnpm --filter google-reviews-mobile start",
