{
  "name": "google-reviews-backend",
  "version": "1.0.0",
  "description": "Google Reviews Management Backend utilizing the Nude Framework",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc",
    "start": "node dist/main.js",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^10.0.2",
    "@lurepos/nude-core": "workspace:*",
    "@lurepos/nude-db": "workspace:*",
    "@lurepos/nude-http": "workspace:*",
    "@lurepos/nude-log": "workspace:*",
    "@sinclair/typebox": "^0.33.24",
    "drizzle-orm": "^0.45.2",
    "fastify": "5.11.2",
    "googleapis": "^144.0.0",
    "openai": "^4.85.4",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.10",
    "typescript": "^5.6.3"
  }
}
